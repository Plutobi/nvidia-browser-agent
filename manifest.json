{
  "manifest_version": 3,
  "name": "NIM Browser Agent",
  "version": "0.10.0",
  "description": "Vision-driven browser automation agent. Captures screenshots and drives clicks/typing/scrolling via injected page scripts, controlled by an NVIDIA NIM vision-language model.",
  "permissions": ["scripting", "tabs", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
